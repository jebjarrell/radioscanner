{
  "version": 8,
  "name": "OnTheGo Scanner - Vector",
  "metadata": {
    "maputnik:renderer": "maplibre"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://./tiles.mbtiles",
      "minzoom": 0,
      "maxzoom": 10
    }
  },
  "sprite": "",
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1a1a1a"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#0f172a",
        "fill-antialias": true
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#1e293b",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": "#262626",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": {
        "line-color": "#334155",
        "line-width": {
          "base": 1.2,
          "stops": [
            [8, 0.5],
            [10, 1]
          ]
        }
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary"],
      "paint": {
        "line-color": "#475569",
        "line-width": {
          "base": 1.2,
          "stops": [
            [6, 0.5],
            [8, 1],
            [10, 2]
          ]
        }
      }
    },
    {
      "id": "road_highway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#64748b",
        "line-width": {
          "base": 1.2,
          "stops": [
            [5, 0.5],
            [7, 1],
            [9, 2],
            [10, 3]
          ]
        }
      }
    },
    {
      "id": "admin_boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#64748b",
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "place_labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [
            [6, 10],
            [10, 14]
          ]
        },
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#94a3b8",
        "text-halo-color": "#1a1a1a",
        "text-halo-width": 1
      }
    }
  ]
}
